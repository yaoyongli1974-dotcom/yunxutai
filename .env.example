APP_NAME="静思园"
APP_ENV=local
APP_DEBUG=true
APP_URL=
APP_TIMEZONE=Asia/Shanghai
APP_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jidian
DB_USERNAME=root
DB_PASSWORD=

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
SUPPORT_EMAIL=support@example.com

# AI 自助工作室（不填 API Key 时可设为 demo，使用本地增强/模板演示）
AI_ENABLED=false
AI_PROVIDER=demo
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_TEXT_MODEL=gpt-4.1-mini
AI_IMAGE_MODEL=gpt-image-1
AI_TIMEOUT=120
AI_DAILY_LIMIT=10
AI_SYNC=true
FFMPEG_BIN=/usr/bin/ffmpeg

# 小程序 / API
# 配置微信小程序 AppID/Secret 后，/api/v1/auth/wechat 自动启用 code2session 登录
WX_APPID=wxbc412a94ff7e7e45
WX_SECRET=

# KV / Redis（多实例部署可选）
# 留空 = MySQL throttle 表限流 + PHP 文件会话（单机默认行为）
# 启用示例：redis://127.0.0.1:6379/0
# 带密码：redis://:your-password@127.0.0.1:6379/0
# 指定库：redis://127.0.0.1:6379/2
REDIS_URL=
# 限流驱动记录字段（当前以 REDIS_URL 是否为空判定实际驱动，此字段供配置与后续扩展）
RATE_DRIVER=mysql
