.page{padding:24rpx;background:#f7f3ea;min-height:100vh}
.head{padding:12rpx 0 24rpx}.title{font-size:40rpx;color:#272119;font-weight:600;display:block}.sub{font-size:24rpx;color:#877d6d}
.bar{padding:20rpx;background:#fbf8f1;border:1rpx solid #decfba;border-radius:6rpx;text-align:center;font-size:26rpx;color:#40503b;margin-bottom:20rpx}
.empty{color:#877d6d;font-size:24rpx;padding:40rpx 0;text-align:center}
.card{background:#fbf8f1;border:1rpx solid #decfba;border-radius:6rpx;padding:20rpx;margin:12rpx 0}
.card.unread{border-left:6rpx solid #9c3d33}.card-title{font-size:30rpx;color:#272119;display:block}
.card-meta{font-size:22rpx;color:#877d6d;display:block;margin-top:6rpx}.card-body{font-size:25rpx;color:#524b40;display:block;margin-top:10rpx}
