<view class="page">
  <view class="head"><text class="title">家族纪事</text><text class="sub">{{familyName}}</text></view>
  <view class="empty" wx:if="{{!loading && !events.length}}">还没有家族事件。</view>
  <view class="card" wx:for="{{events}}" wx:key="id">
    <text class="card-date">{{item.date}}</text>
    <text class="card-title">{{item.title}}</text>
    <text class="card-meta">来源：{{item.source}} · {{item.typeLabel}}</text>
    <text class="card-meta" wx:if="{{item.location}}">地点：{{item.location}}</text>
    <text class="card-desc" wx:if="{{item.description}}">{{item.description}}</text>
  </view>
</view>
