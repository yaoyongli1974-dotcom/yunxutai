.page{padding:24rpx;background:#f7f3ea;min-height:100vh}
.head{padding:12rpx 0 24rpx}.title{font-size:40rpx;color:#272119;font-weight:600;display:block}.sub{font-size:24rpx;color:#877d6d}
.bar{margin:12rpx 0;padding:24rpx;background:#5d6f55;color:#fff;border-radius:6rpx;text-align:center;font-size:28rpx}
.form{background:#fbf8f1;border:1rpx solid #decfba;border-radius:6rpx;padding:20rpx;margin-bottom:20rpx}
.field{display:block;background:#fff;border:1rpx solid #decfba;padding:18rpx;margin:12rpx 0;border-radius:4rpx;font-size:28rpx;color:#272119}
.primary{background:#5d6f55;color:#fff;font-size:28rpx;margin-top:12rpx}
.empty{color:#877d6d;font-size:24rpx;padding:40rpx 0;text-align:center}
.card{background:#fbf8f1;border:1rpx solid #decfba;border-radius:6rpx;padding:20rpx;margin:12rpx 0}
.card-title{font-size:30rpx;color:#272119;display:block}.card-meta{font-size:24rpx;color:#877d6d;display:block;margin-top:6rpx}
