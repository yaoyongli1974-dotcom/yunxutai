<view class="page">
  <view class="head"><text class="title">数字档案</text><text class="sub">{{familyName}}</text></view>
  <view class="bar" bindtap="toggleForm">＋ 新建档案</view>
  <view class="form" wx:if="{{showForm}}">
    <input class="field" placeholder="档案标题" value="{{title}}" bindinput="onTitle" />
    <input class="field" placeholder="类型：document/photo/audio/video" value="{{archiveType}}" bindinput="onType" />
    <button class="primary" bindtap="onCreate">创建</button>
  </view>
  <view class="empty" wx:if="{{!loading && !archives.length}}">暂无可查看的档案。</view>
  <view class="card" wx:for="{{archives}}" wx:key="id">
    <text class="card-title">{{item.title}}</text>
    <text class="card-meta">{{item.archive_type || '未分类'}} · {{item.event_date || '日期未知'}}</text>
  </view>
</view>
