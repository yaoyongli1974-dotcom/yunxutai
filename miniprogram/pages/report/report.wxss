.picker-value {
  line-height: 88rpx;
}

.textarea {
  min-height: 200rpx;
  padding: 20rpx 24rpx;
  line-height: 1.6;
}

.tip {
  margin-bottom: 40rpx;
  padding: 20rpx 24rpx;
  background: #f3ecdd;
  border-radius: 12rpx;
  color: #8a6b2f;
  font-size: 22rpx;
  line-height: 1.7;
}

.footnote {
  display: block;
  margin-top: 24rpx;
  color: #8a7f70;
  font-size: 22rpx;
  line-height: 1.6;
  text-align: center;
}
