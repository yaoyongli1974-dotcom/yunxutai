<view class="page">
  <view class="head"><text class="title">AI 家族记忆工坊</text><text class="sub">{{familyName}}</text></view>
  <view class="caveat">人工复核提示：AI 提取结果仅为候选事实，必须经过人工确认后才能采用；请勿直接作为正式家族史料。</view>

  <view class="section-title">新建提取任务</view>
  <view class="form">
    <textarea class="field area" placeholder="粘贴家族口述或档案文字" value="{{text}}" bindinput="onText" maxlength="-1" />
    <button class="primary" loading="{{submitting}}" bindtap="onSubmit">提交提取任务</button>
  </view>

  <view class="section-title" wx:if="{{workflowId}}">任务 #{{workflowId}}</view>
  <view class="card" wx:if="{{workflow}}">
    <view class="card-head">
      <text class="card-title">{{workflow.typeLabel}}</text>
      <text class="tag">{{workflow.statusLabel}}</text>
    </view>
    <text class="card-meta">当前步骤：{{workflow.currentStep || '—'}}</text>
    <text class="card-meta">提交时间：{{workflow.createdAt || '—'}}</text>
    <text class="card-meta" wx:if="{{workflow.finishedAt}}">完成时间：{{workflow.finishedAt}}</text>
    <text class="card-meta warn" wx:if="{{workflow.failureClass}}">失败类型：{{workflow.failureClass}}</text>
    <text class="card-meta">任务状态会自动刷新；若长时间未更新，请下拉刷新。</text>
  </view>
  <view class="step" wx:for="{{steps}}" wx:key="id">
    <text class="step-title">{{item.label}}</text>
    <text class="card-meta">状态：{{item.statusLabel}} · 结果：{{item.outputLabel}}</text>
    <text class="card-meta warn" wx:if="{{item.error}}">错误：{{item.error}}</text>
  </view>

  <view class="bar" bindtap="onToggleSessions">{{showSessions ? '收起口述会话' : '查看口述会话'}}</view>
  <block wx:if="{{showSessions}}">
    <view class="section-title">口述会话（{{sessions.length}}）</view>
    <view class="empty" wx:if="{{sessionsLoaded && !sessions.length}}">还没有口述会话。</view>
    <view class="card" wx:for="{{sessions}}" wx:key="id">
      <text class="card-title">{{item.title}}</text>
      <text class="card-meta">主题：{{item.topic || '未填写'}}</text>
      <text class="card-meta">采访人：{{item.interviewer || '未填写'}}</text>
      <text class="card-meta">授权：{{item.consentLabel}} · 进度：{{item.processingLabel}}</text>
    </view>
  </block>
</view>
