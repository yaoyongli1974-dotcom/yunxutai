<view class="page">
  <view class="head"><text class="title">接受家族邀请</text><text class="sub">记取来时路，安放未尽言</text></view>
  <view class="form">
    <text class="label">邀请令牌</text>
    <input class="field" placeholder="请粘贴邀请链接中的令牌" value="{{token}}" bindinput="onToken" />
    <text class="tip">令牌来自家族成员发出的邀请链接，也可直接通过链接打开本页。</text>
    <button class="primary" loading="{{submitting}}" bindtap="onSubmit">接受邀请</button>
  </view>
  <view class="error" wx:if="{{error}}">{{error}}</view>
  <view class="bar" bindtap="onBack">返回家族列表</view>
</view>
