.page{padding:24rpx;background:#f7f3ea;min-height:100vh}
.head{padding:12rpx 0 24rpx}.title{font-size:40rpx;color:#272119;font-weight:600;display:block}.sub{font-size:24rpx;color:#877d6d;display:block;margin-top:8rpx}
.grid{display:flex;justify-content:space-between;margin-bottom:24rpx}
.entry{flex:1;background:#fbf8f1;border:1rpx solid #decfba;border-radius:6rpx;padding:24rpx;margin-right:12rpx;font-size:26rpx;color:#40503b}
.entry:last-child{margin-right:0}.arrow{float:right;color:#877d6d}
.section-title{font-size:30rpx;color:#272119;margin:24rpx 0 12rpx;font-weight:600}
.card{background:#fbf8f1;border:1rpx solid #decfba;border-radius:6rpx;padding:20rpx;margin:12rpx 0}
.card-title{font-size:30rpx;color:#272119;display:block}.card-meta{font-size:24rpx;color:#877d6d;display:block;margin-top:6rpx}
.empty{color:#877d6d;font-size:24rpx;padding:20rpx 0}
