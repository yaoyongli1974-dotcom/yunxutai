.account-page {
  padding-top: 120rpx;
}

.profile-card {
  display: flex;
  align-items: center;
  margin-bottom: 48rpx;
  padding: 40rpx 32rpx;
  background: #fffdf8;
  border: 1rpx solid #e2d9c9;
  border-radius: 16rpx;
}

.avatar {
  width: 110rpx;
  height: 110rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #3f5a4c;
  border-radius: 50%;
  color: #fff;
  font-size: 44rpx;
}

.profile-main {
  margin-left: 28rpx;
  overflow: hidden;
}

.profile-name {
  display: block;
  font-size: 34rpx;
}

.profile-email {
  display: block;
  margin-top: 10rpx;
  color: #8a7f70;
  font-size: 24rpx;
}

.memberships {
  display: block;
  font-size: 26rpx;
  line-height: 1.8;
}

.muted {
  color: #8a7f70;
}

.note {
  display: block;
  margin-bottom: 8rpx;
  color: #8a7f70;
  font-size: 24rpx;
  line-height: 1.7;
}

.btn.logout {
  margin-top: 48rpx;
  background: #fffdf8;
  color: #b4534b;
  border: 1rpx solid #e2c9c5;
}

.state-text-block {
  padding: 160rpx 0;
  text-align: center;
}

.state-text {
  display: block;
  color: #8a7f70;
  font-size: 24rpx;
}

.state-title {
  display: block;
  margin-bottom: 24rpx;
  font-size: 30rpx;
}
