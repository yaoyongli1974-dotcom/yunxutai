.detail-page {
  padding: 32rpx 32rpx 200rpx;
}

.state-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 24rpx;
}

.state-title {
  color: #2f2a24;
  font-size: 32rpx;
  letter-spacing: 2rpx;
}

.state-text {
  margin-top: 16rpx;
  color: #9a8f80;
  font-size: 24rpx;
  line-height: 1.7;
  text-align: center;
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0 48rpx;
}

.hero-portrait {
  width: 220rpx;
  height: 220rpx;
  overflow: hidden;
  background: #f1ebdf;
  border: 1rpx solid #e2d9c9;
  border-radius: 110rpx;
}

.hero-img {
  width: 220rpx;
  height: 220rpx;
}

.hero-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}

.hero-initial {
  color: #b3a898;
  font-size: 80rpx;
}

.hero-name {
  margin-top: 32rpx;
  color: #2f2a24;
  font-size: 44rpx;
  letter-spacing: 6rpx;
}

.hero-title {
  margin-top: 12rpx;
  color: #8a7f70;
  font-size: 24rpx;
}

.hero-life {
  margin-top: 12rpx;
  color: #6b6257;
  font-size: 24rpx;
  letter-spacing: 1rpx;
}

.hero-role {
  margin-top: 16rpx;
  padding: 4rpx 20rpx;
  border: 1rpx solid #3f5a4c;
  border-radius: 8rpx;
  color: #3f5a4c;
  font-size: 22rpx;
}

.hero-quote {
  margin-top: 28rpx;
  padding: 0 24rpx;
  color: #8a7f70;
  font-size: 26rpx;
  line-height: 1.9;
  text-align: center;
}

.block {
  margin-bottom: 32rpx;
  padding: 32rpx 32rpx 36rpx;
  background: #fffdf8;
  border: 1rpx solid #e6ddcd;
  border-radius: 20rpx;
}

.block-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.block-title {
  color: #3f5a4c;
  font-size: 28rpx;
  letter-spacing: 4rpx;
}

.block-note {
  color: #9a8f80;
  font-size: 22rpx;
}

.meta-row {
  display: flex;
  margin-top: 20rpx;
}

.meta-key {
  width: 96rpx;
  color: #9a8f80;
  font-size: 24rpx;
  flex-shrink: 0;
}

.meta-value {
  color: #3f3226;
  font-size: 24rpx;
  line-height: 1.6;
}

.bio {
  display: block;
  margin-top: 24rpx;
  color: #3f3226;
  font-size: 26rpx;
  line-height: 1.9;
}

.tribute-block {
  margin-top: 8rpx;
}

.tribute-grid {
  display: flex;
  justify-content: space-between;
  margin-top: 28rpx;
}

.tribute-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 25%;
}

.tribute-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  background: #f7f3ea;
  border: 1rpx solid #e2d9c9;
  border-radius: 44rpx;
  color: #3f5a4c;
  font-size: 30rpx;
}

.tribute-item.is-pending .tribute-mark {
  border-color: #3f5a4c;
  color: #9a8f80;
}

.tribute-item.is-pending .tribute-label {
  color: #b3a898;
}

.tribute-label {
  margin-top: 12rpx;
  color: #6b6257;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.appendix {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #efe7da;
}

.appendix-input {
  flex: 1;
  height: 56rpx;
  color: #3f3226;
  font-size: 24rpx;
}

.anonymous {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.anonymous-label {
  margin-right: 6rpx;
  color: #9a8f80;
  font-size: 22rpx;
}

.timeline {
  margin-top: 24rpx;
}

.tl-item {
  display: flex;
  padding-bottom: 28rpx;
}

.tl-item:last-child {
  padding-bottom: 0;
}

.tl-dot {
  width: 12rpx;
  height: 12rpx;
  margin: 12rpx 20rpx 0 0;
  background: #3f5a4c;
  border-radius: 50%;
  flex-shrink: 0;
}

.tl-body {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.tl-date {
  color: #9a8f80;
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

.tl-title {
  margin-top: 6rpx;
  color: #2f2a24;
  font-size: 28rpx;
}

.tl-desc {
  margin-top: 8rpx;
  color: #6b6257;
  font-size: 24rpx;
  line-height: 1.7;
}

.tl-loc {
  margin-top: 6rpx;
  color: #9a8f80;
  font-size: 22rpx;
}

.article {
  display: flex;
  flex-direction: column;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #efe7da;
}

.article:last-child {
  padding-bottom: 0;
  border-bottom: none;
}

.article-title {
  color: #2f2a24;
  font-size: 28rpx;
  line-height: 1.6;
}

.article-meta {
  margin-top: 8rpx;
  color: #9a8f80;
  font-size: 22rpx;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 24rpx -8rpx 0;
}

.photo-cell {
  width: 50%;
  padding: 0 8rpx 20rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.photo {
  width: 100%;
  height: 220rpx;
  background: #f1ebdf;
  border-radius: 12rpx;
}

.photo-broken {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx dashed #e2d9c9;
  box-sizing: border-box;
}

.photo-broken-text {
  color: #b3a898;
  font-size: 22rpx;
}

.photo-caption {
  margin-top: 10rpx;
  color: #8a7f70;
  font-size: 22rpx;
  line-height: 1.5;
}

.media-other {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 20rpx;
  background: #f7f3ea;
  border-radius: 12rpx;
}

.media-kind {
  padding: 2rpx 12rpx;
  border: 1rpx solid #e2d9c9;
  border-radius: 6rpx;
  color: #8a7f70;
  font-size: 20rpx;
}

.media-caption {
  margin-left: 16rpx;
  color: #6b6257;
  font-size: 24rpx;
}

.guest-form {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #f7f3ea;
  border-radius: 12rpx;
}

.guest-input {
  width: 100%;
  min-height: 120rpx;
  color: #3f3226;
  font-size: 26rpx;
  line-height: 1.7;
}

.guest-actions {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.guest-count {
  flex: 1;
  color: #b3a898;
  font-size: 20rpx;
  text-align: right;
  margin-right: 16rpx;
}

.guest-submit {
  margin: 0;
  min-width: 140rpx;
}

.guest-list {
  margin-top: 8rpx;
}

.guest-item {
  padding: 28rpx 0;
  border-bottom: 1rpx solid #efe7da;
}

.guest-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.guest-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.guest-author {
  color: #3f5a4c;
  font-size: 24rpx;
}

.guest-time {
  color: #b3a898;
  font-size: 20rpx;
}

.guest-content {
  display: block;
  margin-top: 12rpx;
  color: #3f3226;
  font-size: 26rpx;
  line-height: 1.8;
}

.state {
  padding: 32rpx 0 8rpx;
  color: #9a8f80;
  font-size: 22rpx;
  text-align: center;
}

.fab {
  position: fixed;
  right: 32rpx;
  bottom: 48rpx;
  padding: 20rpx 32rpx;
  background: #3f5a4c;
  border-radius: 44rpx;
  box-shadow: 0 8rpx 24rpx rgba(63, 90, 76, 0.28);
  color: #fff;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  z-index: 10;
}
