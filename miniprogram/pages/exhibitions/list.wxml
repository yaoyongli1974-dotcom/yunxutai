<view class="page">
  <view class="head"><text class="title">家族展馆</text><text class="sub">{{familyName}}</text></view>
  <view class="empty" wx:if="{{!loading && !exhibitions.length}}">暂无可查看的展馆。</view>
  <view class="card" wx:for="{{exhibitions}}" wx:key="id">
    <view class="card-head">
      <text class="card-title">{{item.title}}</text>
      <text class="tag">{{item.statusLabel}}</text>
    </view>
    <text class="card-meta">{{item.privacyLabel}}<block wx:if="{{item.theme}}"> · {{item.theme}}</block></text>
    <text class="card-desc" wx:if="{{item.description}}">{{item.description}}</text>
    <view class="publish" wx:if="{{item.canPublish}}" data-id="{{item.id}}" bindtap="onPublish">发布展馆</view>
  </view>
</view>
